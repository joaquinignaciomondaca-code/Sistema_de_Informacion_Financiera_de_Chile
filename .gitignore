# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Large raw CSV files (DuckDB-Wasm uses Parquets; CSVs exceed GitHub 100MB limit)
*.csv
# Excepción: los artefactos de reproducibilidad del sitio son chicos y se publican
!docs/reproducibilidad/*.csv
# Excepción: el contrato de la API (tabla de reconciliación) se versiona con el código
!docs/api/*.csv
docs/outputs/**/*.csv
seguros/circular_1835_cartera/outputs/**/*.csv

# Redundant duplicate local output folder
seguros/circular_1835_cartera/outputs/

# Large unpartitioned file > 100 MB (use partitioned cartera_bonos_2016_2020.parquet and cartera_bonos_2021_2024.parquet)
docs/outputs/vida/cartera_bonos.parquet

# Temporary files & agent logs
*.tmp
*.temp
*.log
.system_generated/
.DS_Store
Thumbs.db

# Scratch / working files and one-off source downloads (no versionear)
scratch/
FSB_Patrimonio_Separado (4).xlsx

# Local credentials and staging datasets (never publish)
.env
.env.*
!.env.example
.local-data/

# Dependencias de Node para las auditorías JS (se instalan a mano: npm install --no-save jsdom)
node_modules/

# Snapshots académicos locales (se construyen, no se versionan)
snapshot/

# Las excepciones de arriba quedan anuladas por los patrones que vienen después
# (*.log, *.csv), así que la evidencia que sí se publica va al final.
# Evidencia de la prueba de máquina limpia (tarea 1a.8).
!docs/api/prueba_maquina_limpia.log
